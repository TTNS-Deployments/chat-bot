# ==============================================================================
# skus.env - SKU, tier and capacity inputs for the RAG chatbot stack
#
# Edit this file to size the deployment. deploy.sh and deploy-openai.sh read it,
# so you never need to touch the ARM templates to change a SKU.
# Use a different file with:  SKU_FILE=/path/to/other.env ./deploy.sh
#
# Values are plain shell assignments (no spaces around "=").
# Always check current pricing and regional availability before deploying:
#   https://azure.microsoft.com/en-us/pricing/calculator/
# ==============================================================================

# ---------- Application Gateway (public entry point) ----------
# Valid: Standard_v2
APPGW_SKU="Standard_v2"
# Fixed instance count, 1 to 125. Each instance is billed continuously.
APPGW_CAPACITY=1

# ---------- App Service (chatbot web app / orchestration) ----------
# Examples: B1, B2, S1, S2, P1v2, P1v3, P2v3. Private endpoints need Basic (B1) or above.
# Free and Shared plans (F1, D1) will not work with this architecture.
APP_PLAN_SKU="P1v3"
# Linux runtime stack. Examples: PYTHON|3.12, NODE|20-lts, DOTNETCORE|8.0
APP_RUNTIME="PYTHON|3.12"

# ---------- Azure OpenAI ----------
# Account tier. Valid: S0
OPENAI_ACCOUNT_SKU="S0"

# Chat model (answer generation).
# NOTE: gpt-35-turbo is retired or retiring and may no longer be deployable. Confirm what
# your region offers before you deploy:
#   az cognitiveservices model list --location eastus2 -o table
CHAT_MODEL_NAME="gpt-4.1-mini"
CHAT_MODEL_VERSION="2025-04-14"
CHAT_DEPLOYMENT_NAME="chat"
# Deployment type. Valid: Standard, GlobalStandard, DataZoneStandard
# (GlobalStandard and DataZoneStandard may process prompts outside the account region.)
CHAT_DEPLOYMENT_SKU="Standard"
# Capacity in thousands of tokens per minute (30 = 30K TPM). Must fit your regional quota.
CHAT_CAPACITY_K_TPM=30

# Embedding model (ingestion and query vectorization).
# The vector field dimensions in your AI Search index must match the model:
#   text-embedding-3-large = 3072, text-embedding-3-small = 1536, text-embedding-ada-002 = 1536
EMBEDDING_MODEL_NAME="text-embedding-3-large"
EMBEDDING_MODEL_VERSION="1"
EMBEDDING_DEPLOYMENT_NAME="embedding"
EMBEDDING_DEPLOYMENT_SKU="Standard"
EMBEDDING_CAPACITY_K_TPM=30

# ---------- Azure AI Search ----------
# Valid: basic, standard, standard2, standard3. Private endpoints need basic or above.
SEARCH_SKU="standard"
SEARCH_REPLICAS=1
# Valid: 1, 2, 3, 4, 6, 12 (basic tier supports 1 only)
SEARCH_PARTITIONS=1
# Semantic ranker (needed for hybrid + semantic ranking). Valid: disabled, free, standard
SEARCH_SEMANTIC="standard"

# ---------- Cosmos DB (session history) ----------
# Valid: Provisioned, Serverless
COSMOS_CAPACITY_MODE="Provisioned"
# Manual throughput in RU/s, minimum 400. Ignored in Serverless mode.
COSMOS_THROUGHPUT=400

# ---------- Storage Account (source documents) ----------
# Valid: Standard_LRS, Standard_ZRS, Standard_GRS, Standard_RAGRS, Standard_GZRS, Standard_RAGZRS
STORAGE_SKU="Standard_LRS"
# Valid: Hot, Cool
STORAGE_ACCESS_TIER="Hot"

# ---------- Key Vault ----------
# Valid: standard, premium (premium adds HSM-backed keys)
KEYVAULT_SKU="standard"
# Soft-delete retention in days, 7 to 90
KEYVAULT_SOFT_DELETE_DAYS=7

# ---------- Monitoring ----------
# Log Analytics pricing tier. Valid: PerGB2018
LOG_ANALYTICS_SKU="PerGB2018"
# Log Analytics retention, 30 to 730 days
LOG_RETENTION_DAYS=30
# Application Insights retention. Valid: 30, 60, 90, 120, 180, 270, 365, 550, 730
APPINSIGHTS_RETENTION_DAYS=90
