# Copy to .env (make reads it). Everything is optional in local mode.
# See Documents/configuration.md for the full list.

CHATBOT_MODE=local            # local | azure

# --- Use a deployed environment from your machine (values from the deployment outputs) ----
# Your az login identity is used; deploy.sh gives it the roles it needs. No keys.
# CHATBOT_MODE=azure
# AZURE_OPENAI_ENDPOINT=https://<openai-account>.openai.azure.com/
# AZURE_OPENAI_CHAT_DEPLOYMENT=chat
# CHAT_REASONING_EFFORT=low
# AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<embedding-account>.openai.azure.com/   # if different
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding
# AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
# AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
# AZURE_SEARCH_INDEX=documents-index
# AZURE_SEARCH_SEMANTIC_CONFIG=default
# AZURE_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net/
# AZURE_STORAGE_CONTAINER=documents
# AZURE_STORAGE_RESOURCE_ID=<storage account resource ID, from the portal's JSON view>

# --- Demo sign-in (shared password) ----------------------------------------------------------
# AUTH_MODE=password
# DEMO_PASSWORD=choose-a-local-password

# --- Behaviour ---------------------------------------------------------------------------
# UPLOAD_API_KEY=             # set to require a key for uploads in local mode too
# SEARCH_TOP_K=5
# MAX_HISTORY_TURNS=6
# RATE_LIMIT_PER_MINUTE=20
# TRUST_FORWARDED_FOR=false     # true only behind a reverse proxy you trust (automatic on App Service)
