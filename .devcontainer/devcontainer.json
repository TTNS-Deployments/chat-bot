{
  "name": "AI Based Chatbot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": { "installBicep": true },
    "ghcr.io/devcontainers/features/powershell:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y shellcheck && pwsh -NoProfile -Command 'Install-Module PSScriptAnalyzer -Force -Scope CurrentUser' && make setup hooks",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Chat page" } },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-bicep",
        "ms-vscode.powershell",
        "timonwong.shellcheck"
      ]
    }
  }
}
