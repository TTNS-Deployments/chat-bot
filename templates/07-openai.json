    "chatModelName": {
      "type": "string"
    },
    "chatModelVersion": {
      "type": "string"
    },
    "chatDeploymentSku": {
      "type": "string",
      "defaultValue": "Standard"
    },
    "chatCapacity": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Capacity in thousands of tokens per minute."
      }
    },
    "embeddingDeploymentName": {
      "type": "string",
      "defaultValue": "embedding"
