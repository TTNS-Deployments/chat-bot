    "embeddingModelVersion": {
      "type": "string",
      "defaultValue": "1"
    },
    "embeddingDeploymentSku": {
      "type": "string",
      "defaultValue": "Standard"
    },
    "embeddingCapacity": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Capacity in thousands of tokens per minute."
      }
    },
    "peSubnetId": {
      "type": "string"
    },
    "dnsZoneId": {
      "type": "string"
    }
  },
  "variables": {
    "tags": {
      "project": "[parameters('namePrefix')]",
      "environment": "[parameters('environment')]"
    },
    "suffix": "[take(uniqueString(resourceGroup().id), 5)]",
    "accountName": "[toLower(format('oai-{0}-{1}-{2}', take(parameters('namePrefix'), 12), take(parameters('environment'), 3), variables('suffix')))]"
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[variables('accountName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "OpenAI",
      "sku": {
