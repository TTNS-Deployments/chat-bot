      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/{1}', format('pe-{0}', variables('accountName')), 'default')]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "openai",
            "properties": {
              "privateDnsZoneId": "[parameters('dnsZoneId')]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', format('pe-{0}', variables('accountName')))]"
      ]
    }
  ],
  "outputs": {
    "accountName": {
      "type": "string",
