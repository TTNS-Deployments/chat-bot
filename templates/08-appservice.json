{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "18364735823708881102"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "planSku": {
      "type": "string",
      "defaultValue": "P1v3",
      "metadata": {
        "description": "App Service plan SKU, e.g. B1, S1, P1v3. Private endpoints need Basic or above."
      }
    },
    "linuxFxVersion": {
      "type": "string",
      "defaultValue": "PYTHON|3.12",
      "metadata": {
        "description": "Linux runtime, e.g. PYTHON|3.12, NODE|20-lts, DOTNETCORE|8.0."
      }
    },
    "publicNetworkAccess": {
      "type": "string",
      "defaultValue": "Disabled",
      "allowedValues": [
        "Enabled",
        "Disabled"
      ],
      "metadata": {
        "description": "Set Disabled to keep the app reachable only through its private endpoint."
      }
    },
    "appInsightsConnectionString": {
      "type": "string"
    },
    "integrationSubnetId": {
      "type": "string"
    },
    "peSubnetId": {
      "type": "string"
    },
    "dnsZoneId": {
      "type": "string"
    }
  },
  "variables": {
    "tags": {
      "project": "[parameters('namePrefix')]",
      "environment": "[parameters('environment')]"
    },
    "suffix": "[take(uniqueString(resourceGroup().id), 5)]",
    "planName": "[format('asp-{0}-{1}', parameters('namePrefix'), parameters('environment'))]",
    "appName": "[toLower(format('app-{0}-{1}-{2}', take(parameters('namePrefix'), 12), take(parameters('environment'), 3), variables('suffix')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('planSku')]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "publicNetworkAccess": "[parameters('publicNetworkAccess')]",
        "virtualNetworkSubnetId": "[parameters('integrationSubnetId')]",
        "vnetRouteAllEnabled": true,
        "siteConfig": {
          "linuxFxVersion": "[parameters('linuxFxVersion')]",
          "alwaysOn": true,
          "http20Enabled": true,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[parameters('appInsightsConnectionString')]"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2024-05-01",
      "name": "[format('pe-{0}', variables('appName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "subnet": {
          "id": "[parameters('peSubnetId')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "app-connection",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.Web/sites', variables('appName'))]",
              "groupIds": [
                "sites"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('appName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/{1}', format('pe-{0}', variables('appName')), 'default')]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "sites",
            "properties": {
              "privateDnsZoneId": "[parameters('dnsZoneId')]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', format('pe-{0}', variables('appName')))]"
      ]
    }
  ],
  "outputs": {
    "planName": {
      "type": "string",
      "value": "[variables('planName')]"
    },
    "webAppName": {
      "type": "string",
      "value": "[variables('appName')]"
    },
    "webAppId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', variables('appName'))]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-12-01', 'full').identity.principalId]"
    },
    "defaultHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-12-01').defaultHostName]"
    }
  }
}