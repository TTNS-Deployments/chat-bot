{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "4216077185519954092"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "skuName": {
      "type": "string",
      "defaultValue": "standard",
      "allowedValues": [
        "basic",
        "standard",
        "standard2",
        "standard3"
      ]
    },
    "replicaCount": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 12
    },
    "partitionCount": {
      "type": "int",
      "defaultValue": 1,
      "allowedValues": [
        1,
        2,
        3,
        4,
        6,
        12
      ]
    },
    "semanticSearch": {
      "type": "string",
      "defaultValue": "standard",
      "allowedValues": [
        "disabled",
        "free",
        "standard"
      ]
    },
    "peSubnetId": {
      "type": "string"
    },
    "dnsZoneId": {
      "type": "string"
    }
  },
  "variables": {
    "tags": {
      "project": "[parameters('namePrefix')]",
      "environment": "[parameters('environment')]"
    },
    "suffix": "[take(uniqueString(resourceGroup().id), 5)]",
    "serviceName": "[toLower(format('srch-{0}-{1}-{2}', take(parameters('namePrefix'), 12), take(parameters('environment'), 3), variables('suffix')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Search/searchServices",
      "apiVersion": "2023-11-01",
      "name": "[variables('serviceName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "[parameters('skuName')]"
      },
      "properties": {
        "replicaCount": "[parameters('replicaCount')]",
        "partitionCount": "[parameters('partitionCount')]",
        "hostingMode": "default",
        "publicNetworkAccess": "disabled",
        "semanticSearch": "[parameters('semanticSearch')]",
        "disableLocalAuth": false,
        "authOptions": {
          "aadOrApiKey": {
            "aadAuthFailureMode": "http401WithBearerChallenge"
          }
        }
      }
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2024-05-01",
      "name": "[format('pe-{0}', variables('serviceName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "subnet": {
          "id": "[parameters('peSubnetId')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "search-connection",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.Search/searchServices', variables('serviceName'))]",
              "groupIds": [
                "searchService"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Search/searchServices', variables('serviceName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/{1}', format('pe-{0}', variables('serviceName')), 'default')]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "search",
            "properties": {
              "privateDnsZoneId": "[parameters('dnsZoneId')]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', format('pe-{0}', variables('serviceName')))]"
      ]
    }
  ],
  "outputs": {
    "serviceName": {
      "type": "string",
      "value": "[variables('serviceName')]"
    },
    "serviceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Search/searchServices', variables('serviceName'))]"
    },
    "endpoint": {
      "type": "string",
      "value": "[format('https://{0}.search.windows.net', variables('serviceName'))]"
    }
  }
}