              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', format('nsg-{0}-appgw-{1}', parameters('namePrefix'), parameters('environment')))]"
              }
            }
          }
        ]
      },
      "dependsOn": [
