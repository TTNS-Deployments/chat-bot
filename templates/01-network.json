        "[resourceId('Microsoft.Network/privateDnsZones', items(variables('dnsZones'))[copyIndex()].value)]"
      ]
    },
    {
      "copy": {
        "name": "spokeLinks",
        "count": "[length(items(variables('dnsZones')))]"
      },
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', items(variables('dnsZones'))[copyIndex()].value, 'link-spoke')]",
      "location": "global",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', format('vnet-{0}-spoke-{1}', parameters('namePrefix'), parameters('environment')))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', format('vnet-{0}-spoke-{1}', parameters('namePrefix'), parameters('environment')))]",
        "[resourceId('Microsoft.Network/privateDnsZones', items(variables('dnsZones'))[copyIndex()].value)]"
