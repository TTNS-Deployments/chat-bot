        "[resourceId('Microsoft.Network/networkSecurityGroups', format('nsg-{0}-pe-{1}', parameters('namePrefix'), parameters('environment')))]"
      ]
    },
    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/{1}', format('vnet-{0}-hub-{1}', parameters('namePrefix'), parameters('environment')), 'hub-to-spoke')]",
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', format('vnet-{0}-spoke-{1}', parameters('namePrefix'), parameters('environment')))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": true,
        "allowGatewayTransit": false,
        "useRemoteGateways": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', format('vnet-{0}-hub-{1}', parameters('namePrefix'), parameters('environment')))]",
        "[resourceId('Microsoft.Network/virtualNetworks', format('vnet-{0}-spoke-{1}', parameters('namePrefix'), parameters('environment')))]"
      ]
    },
