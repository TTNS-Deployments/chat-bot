    "openAiName": {
      "type": "string"
    },
    "cosmosName": {
      "type": "string"
    },
    "storageName": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'), 'SearchAdminKey')]",
      "properties": {
        "value": "[listAdminKeys(resourceId('Microsoft.Search/searchServices', parameters('searchName')), '2023-11-01').primaryKey]"
