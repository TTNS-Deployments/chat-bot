# Settings for `Deployment/scripts/deploy.sh -e demo` (read with `source`; command-line options win).
# The demo runs from Azure Cloud Shell, where only management API (ARM) calls work: no Microsoft
# Graph, no Kudu/SCM, no Storage or Key Vault data-plane tokens. See Documents/demo-deployment.md.
AZURE_SUBSCRIPTION=""                 # empty = the current az account
RESOURCE_GROUP="Vaibhav.Chaudhary"    # existing resource group; reused, never recreated
LOCATION="centralindia"               # must match the shared App Service plan's region
SEED=1                                # upload Data/sample_docs (the demo's documents)
CODE_VIA_ARM=1                        # deploy the code as a run-from-package zip, with management calls only
